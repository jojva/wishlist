# 64-bit Steam ID of the wishlist to sync (profile must be public), e.g. 76561197960287930
STEAM_ID=
# Twitch developer app credentials for the IGDB API (https://dev.twitch.tv/console/apps)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Public origin the app is served at, e.g. https://wishlist.example.com
# (adapter-node rejects form-action POSTs without it; deploy.sh health-checks it)
ORIGIN=
# SSH destination deploy.sh ships to, e.g. user@host
DEPLOY_HOST=
